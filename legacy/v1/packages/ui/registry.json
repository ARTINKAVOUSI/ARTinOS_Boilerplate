{
  "$schema": "./registry.schema.json",
  "name": "@artinos/ui",
  "version": "1.4.0",
  "description": "Source-owned ARTINOS component registry. Entries are richer than copied TSX: each carries its behaviour, geometry, tokens, metadata and accessibility contract.",
  "runtime": {
    "note": "Shared primitives stay package dependencies; only presentation is installed as source.",
    "packages": ["@artinos/ui/kernel", "@artinos/ui/tokens.css", "@artinos/ui/instrument.css"]
  },
  "components": [
    {
      "id": "slider",
      "name": "Slider",
      "category": "control",
      "description": "Scrub cell. The row is the drag surface; the fill is the value.",
      "files": ["src/primitives/numeric.tsx"],
      "kernel": ["behavior", "geometry", "modifiers", "physics", "interaction"],
      "tokens": ["--bg-row", "--bg-hover", "--fill-track", "--tick", "--sig-live", "--type-value"],
      "parameters": ["number", "integer", "angle"],
      "presentations": ["scrub", "slider", "field"],
      "states": ["idle", "hover", "dragging", "editing", "bound", "warn", "fault", "disabled"],
      "accessibility": {
        "role": "slider",
        "keyboard": ["Arrows ±step", "Shift ×10", "Alt ×0.1", "PageUp/Down ×10", "Home/End", "Enter edit", "Escape cancel"]
      }
    },
    {
      "id": "property-row",
      "name": "PropertyRow",
      "category": "composition",
      "description": "Label, control, unit, status, reset and actions in one consistent relationship.",
      "files": ["src/primitives/PropertyRow.tsx"],
      "kernel": [],
      "tokens": ["--control-h-sm", "--row-gap", "--sig-bind", "--sig-warn", "--sig-fault"],
      "parameters": [],
      "presentations": ["default", "compact", "micro", "multiline"],
      "states": ["default", "bound", "warn", "fault", "disabled", "mixed"]
    },
    {
      "id": "toggle",
      "name": "Toggle",
      "category": "control",
      "description": "Recessed track, square knob, explicit ON/OFF caption.",
      "files": ["src/primitives/choice.tsx"],
      "kernel": [],
      "tokens": ["--bg-well", "--e0-well", "--sig-live"],
      "parameters": ["boolean"],
      "presentations": ["switch"],
      "states": ["default", "checked", "disabled"]
    },
    {
      "id": "knob",
      "name": "Knob",
      "category": "instrument",
      "description": "Angular control on the shared drag mechanics.",
      "files": ["src/primitives/instrument.tsx"],
      "kernel": ["behavior", "geometry", "modifiers"],
      "tokens": ["--bg-well", "--sig-live", "--tick"],
      "parameters": ["number", "angle"],
      "presentations": ["knob", "dial"],
      "states": ["idle", "hover", "dragging", "disabled"]
    },
    {
      "id": "xy-pad",
      "name": "XYPad",
      "category": "instrument",
      "description": "Two axes driven together, mapped through planar geometry.",
      "files": ["src/primitives/instrument.tsx"],
      "kernel": ["geometry"],
      "tokens": ["--bg-well", "--e0-well", "--sig-live"],
      "parameters": ["vec2"],
      "presentations": ["pad"],
      "states": ["idle", "dragging", "disabled"]
    },
    {
      "id": "meter",
      "name": "Meter",
      "category": "instrument",
      "description": "Read-only level with a 3px signal rail.",
      "files": ["src/primitives/instrument.tsx"],
      "kernel": ["geometry"],
      "tokens": ["--fill-track", "--sig-live", "--sig-warn", "--sig-fault"],
      "parameters": ["number"],
      "presentations": ["meter"],
      "states": ["live", "warn", "fault"]
    },
    {
      "id": "waveform",
      "name": "Waveform",
      "category": "instrument",
      "description": "Sampled series scope.",
      "files": ["src/primitives/instrument.tsx"],
      "kernel": ["geometry"],
      "tokens": ["--sig-live", "--line-subtle"],
      "parameters": ["curve"],
      "presentations": ["scope"],
      "states": ["live", "warn", "fault"]
    },
    {
      "id": "inspector",
      "name": "Inspector",
      "category": "composite",
      "description": "Per-parameter subscribed property grid with search, grouping and reset.",
      "files": ["src/primitives/PropertyRow.tsx"],
      "kernel": ["registry"],
      "tokens": ["--panel-header-h", "--space-5", "--type-panel"],
      "parameters": ["*"],
      "presentations": ["inspector"],
      "states": ["default", "empty", "filtered"]
    },
    { "id": "number-field", "name": "NumberField", "category": "control", "description": "Typed numeric entry with shared numeric semantics.", "files": ["src/primitives/numeric.tsx"], "parameters": ["number", "integer", "angle"], "states": ["idle", "editing", "fault"] },
    { "id": "range-slider", "name": "RangeSlider", "category": "control", "description": "Two-thumb numeric range editor.", "files": ["src/primitives/numeric.tsx"], "parameters": ["range"], "states": ["idle", "dragging", "mixed"] },
    { "id": "dial", "name": "Dial", "category": "control", "description": "Compact angular number presentation.", "files": ["src/primitives/numeric.tsx"], "parameters": ["number", "angle"], "states": ["idle", "dragging"] },
    { "id": "checkbox", "name": "Checkbox", "category": "control", "description": "Boolean check presentation.", "files": ["src/primitives/choice.tsx"], "parameters": ["boolean"], "states": ["checked", "disabled"] },
    { "id": "select", "name": "Select", "category": "control", "description": "Single choice selector.", "files": ["src/primitives/choice.tsx"], "parameters": ["enum", "string"], "states": ["idle", "open"] },
    { "id": "segmented-control", "name": "Segmented", "category": "control", "description": "Compact mutually exclusive choices.", "files": ["src/primitives/choice.tsx"], "parameters": ["enum"], "states": ["idle", "selected"] },
    { "id": "tabs", "name": "Tabs", "category": "navigation", "description": "Keyboard-ready tab navigation.", "files": ["src/primitives/choice.tsx"], "parameters": [], "states": ["selected"] },
    { "id": "text-field", "name": "TextField", "category": "control", "description": "Single-line text authoring.", "files": ["src/primitives/text.tsx"], "parameters": ["string"], "states": ["idle", "editing"] },
    { "id": "textarea", "name": "TextArea", "category": "control", "description": "Multiline text authoring.", "files": ["src/primitives/text.tsx"], "parameters": ["string"], "states": ["idle", "editing"] },
    { "id": "search", "name": "SearchField", "category": "control", "description": "Search input with clearing semantics.", "files": ["src/primitives/text.tsx"], "parameters": ["string"], "states": ["idle", "filled"] },
    { "id": "color-control", "name": "ColorControl", "category": "instrument", "description": "Semantic color space editor.", "files": ["src/primitives/color.tsx"], "parameters": ["color"], "states": ["idle", "dragging"] },
    { "id": "gradient-editor", "name": "GradientEditor", "category": "instrument", "description": "Editable semantic gradient stops.", "files": ["src/primitives/color.tsx"], "parameters": ["gradient"], "states": ["idle", "selected", "dragging"] },
    { "id": "vector-field", "name": "VectorField", "category": "control", "description": "Vector component number fields.", "files": ["src/primitives/vector.tsx"], "parameters": ["vec2", "vec3", "vec4"], "states": ["idle", "editing"] },
    { "id": "xyz-control", "name": "XYZControl", "category": "instrument", "description": "Axis-aware three component editor.", "files": ["src/primitives/vector.tsx"], "parameters": ["vec3"], "states": ["idle", "editing"] },
    { "id": "quaternion-control", "name": "QuaternionControl", "category": "instrument", "description": "Four component quaternion editor.", "files": ["src/primitives/vector.tsx"], "parameters": ["vec4", "quaternion"], "states": ["idle", "editing"] },
    { "id": "joystick", "name": "Joystick", "category": "instrument", "description": "Spring-return planar controller.", "files": ["src/primitives/instrument.tsx"], "parameters": ["vec2"], "states": ["idle", "dragging", "settling"] },
    { "id": "curve-editor", "name": "CurveControl", "category": "instrument", "description": "Accessible multi-point curve editor.", "files": ["src/primitives/curve.tsx"], "parameters": ["curve"], "states": ["idle", "selected", "dragging"] },
    { "id": "envelope-editor", "name": "EnvelopeEditor", "category": "instrument", "description": "ADSR envelope editor.", "files": ["src/primitives/curve.tsx"], "parameters": ["envelope"], "states": ["idle", "editing"] },
    { "id": "graph-editor", "name": "GraphEditor", "category": "instrument", "description": "Composable semantic graph surface.", "files": ["src/primitives/curve.tsx"], "parameters": ["graph"], "states": ["idle", "selected"] },
    { "id": "asset-field", "name": "AssetField", "category": "control", "description": "Semantic project asset picker.", "files": ["src/primitives/files.tsx"], "parameters": ["asset", "texture"], "states": ["empty", "selected"] },
    { "id": "popover", "name": "Popover", "category": "overlay", "description": "Positioned dismissible focus-managed overlay.", "files": ["src/primitives/overlays.tsx"], "parameters": [], "states": ["closed", "open"] },
    { "id": "menu", "name": "Menu", "category": "overlay", "description": "Keyboard collection menu.", "files": ["src/primitives/overlays.tsx"], "parameters": [], "states": ["closed", "open"] },
    { "id": "dialog", "name": "Dialog", "category": "overlay", "description": "Modal focus scope with dismissal.", "files": ["src/primitives/overlays.tsx"], "parameters": [], "states": ["closed", "open"] },
    { "id": "drawer", "name": "Drawer", "category": "overlay", "description": "Edge-oriented modal surface.", "files": ["src/primitives/overlays.tsx"], "parameters": [], "states": ["closed", "open"] },
    { "id": "combobox", "name": "Combobox", "category": "collection", "description": "Filterable listbox control.", "files": ["src/primitives/collections.tsx"], "parameters": ["enum", "string"], "states": ["closed", "open", "selected"] },
    { "id": "accordion", "name": "Accordion", "category": "collection", "description": "Expandable content collection.", "files": ["src/primitives/collections.tsx"], "parameters": [], "states": ["collapsed", "expanded"] },
    { "id": "virtual-list", "name": "VirtualList", "category": "collection", "description": "Uniform and variable windowed collections.", "files": ["src/primitives/list.tsx"], "parameters": [], "states": ["empty", "populated"] },
    { "id": "virtual-table", "name": "VirtualTable", "category": "collection", "description": "Windowed semantic table.", "files": ["src/primitives/list.tsx"], "parameters": [], "states": ["empty", "populated"] },
    { "id": "panel-workspace", "name": "PanelWorkspace", "category": "workspace", "description": "Serializable dock, float and split workspace.", "files": ["src/shell/PanelWorkspace.tsx"], "parameters": [], "states": ["docked", "floating"] }
  ]
}
